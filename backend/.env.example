# Copy this file to .env and fill in real values for local dev. For a
# production deployment, see docs/deployment.md — it walks through every
# variable below that actually matters there (SECRET_KEY, DATABASE_URL,
# CORS_ORIGINS, APP_ENV) plus Docker, migrations, health checks, and
# concrete AWS/GCP/DigitalOcean + Vercel/Netlify deployment paths.

# Application
APP_NAME=AI Receptionist
# "development"/"dev"/"test"/"testing"/"local" are treated as non-production;
# anything else (e.g. "production", "staging") enables production-mode
# checks — most importantly, the app refuses to start with the default
# SECRET_KEY below (see app/core/config.py).
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Logging
LOG_LEVEL=INFO
# "json" (default — structured, one object per line) or "text" (human-readable, for local dev)
LOG_FORMAT=json

# Database (PostgreSQL)
# Either set DATABASE_URL directly, or leave it blank and fill in the
# POSTGRES_* fields below — the app assembles the URL from those.
# Never commit real credentials; this file only holds placeholders.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_receptionist

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth
# Generate a real secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Receptionist / LLM
# LLM_PROVIDER selects the provider; if its API key below is blank, the app
# automatically falls back to a deterministic mock LLM (no credentials
# needed to run or test the AI Receptionist).
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Multilingual live-voice defaults (comma-separated language codes). A
# workspace can override this via its ai_agents.config "supported_languages"
# field. Codes: en=English, ur=Urdu, pa=Punjabi (Shahmukhi), skr=Saraiki,
# sd=Sindhi, ps=Pashto. (es/fr/de stay registered in the catalog for older
# deployments but are no longer in the default set.)
DEFAULT_SUPPORTED_LANGUAGES=en,ur,pa,skr,sd,ps
LANGUAGE_DETECTION_MIN_CONFIDENCE=0.5

# Appointment reminders / confirmations are ONLY ever written in English or
# Urdu, regardless of the language the call was held in. Override per
# workspace via its clinic_notifications integration config
# ("notification_language"). Only "en" and "ur" are honoured.
NOTIFICATION_DEFAULT_LANGUAGE=en

# Day-of reminder background job (in-process hourly scheduler; not
# Celery/Redis). Sends each workspace's reminders when its local clock
# reaches REMINDER_LOCAL_HOUR.
REMINDERS_ENABLED=true
REMINDER_LOCAL_HOUR=8

# Telephony / real-time voice pipeline
# Each *_PROVIDER selects the adapter; if its credentials below are blank,
# the app automatically falls back to a deterministic mock adapter (no
# credentials needed to run or test the voice pipeline).
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VAPI_API_KEY=
VAPI_TOOL_WEBHOOK_SECRET=
VAPI_AVAILABILITY_TOKEN_EXPIRE_SECONDS=1800

STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

CALL_IDLE_TIMEOUT_SECONDS=8.0
CALL_MAX_IDLE_STRIKES=3

# Calendar integration (Google Calendar)
# CALENDAR_PROVIDER selects the provider; if GOOGLE_SERVICE_ACCOUNT_JSON is
# blank/invalid, the app automatically falls back to a deterministic mock
# calendar (no credentials needed to run or test). Each workspace opts in
# separately via an `integrations` row (provider="google_calendar",
# config={"calendar_id": "..."}) — this server-level credential just says
# *how* to authenticate, not which workspaces use it.
CALENDAR_PROVIDER=mock
# Paste the full service-account JSON key as a single line, e.g.:
#   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10.0
# Google OAuth web client for self-service clinic connections. The callback
# must be registered verbatim in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Notifications (WhatsApp + email)
# Each *_PROVIDER selects the adapter; if its credentials below are blank,
# the app automatically falls back to a deterministic mock adapter (no
# credentials needed to run or test). Each workspace opts a clinic contact
# in separately via an `integrations` row (provider="clinic_notifications",
# config={"whatsapp_number": "...", "email": "..."}).
WHATSAPP_PROVIDER=mock
# Twilio WhatsApp (reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above)
WHATSAPP_FROM_NUMBER=
# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

NOTIFICATION_TIMEOUT_SECONDS=10.0
